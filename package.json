{
  "name": "ritsumeikan-campus-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-en-index.mjs && node scripts/check-search-data.mjs && vite",
    "build": "node scripts/sync-en-index.mjs && node scripts/check-search-data.mjs && vite build",
    "test": "node --test",
    "test:site": "node scripts/run-site-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:inventory": "node scripts/site-action-inventory.mjs",
    "sync:en": "node scripts/sync-en-index.mjs",
    "check:en": "node scripts/sync-en-index.mjs --check",
    "check:search-data": "node scripts/check-search-data.mjs",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^7.1.7"
  }
}
